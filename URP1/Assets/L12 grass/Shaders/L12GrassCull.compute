#pragma kernel CullGrass

StructuredBuffer<float4> _SourceBladeData;
AppendStructuredBuffer<float4> _VisibleBladeData0;
AppendStructuredBuffer<float4> _VisibleBladeData1;
AppendStructuredBuffer<float4> _VisibleBladeData2;
Texture2D<float4> _DensityTexture;

float4 _FieldOrigin;
float4 _CameraPosition;
float4 _FrustumPlanes[6];
float4 _FieldScale;
float4 _FieldSize;
float _BladeHeight;
float _MaxDrawDistance;
float _CullPadding;
float _Lod0Distance;
float _Lod1Distance;
float _DensityThreshold;
float _DensityInfluence;
int _UseDensityTexture;
int _SourceOffset;
int _SourceCount;
float4 _TerrainHeightParams;
float4 _TerrainHeightOffset;

float Hash12(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453123);
}

float SampleDensity(float2 localXZ)
{
    float density = 1.0;
    if (_UseDensityTexture != 0)
    {
        uint width = 1;
        uint height = 1;
        _DensityTexture.GetDimensions(width, height);

        float2 textureSize = max(float2(width, height), 1.0);
        float2 scaledLocalXZ = localXZ * _FieldScale.xy;
        float2 uv = saturate((scaledLocalXZ + _FieldSize.xy * 0.5) / max(_FieldSize.xy, 0.001));
        int2 pixel = int2(clamp(floor(uv * textureSize), 0.0, textureSize - 1.0));
        density = _DensityTexture.Load(int3(pixel, 0)).r * _DensityInfluence;
    }
    return saturate(density);
}

float SampleTerrainHeight(float2 worldXZ)
{
    float2 p = worldXZ + _TerrainHeightOffset.xy;
    float frequency = max(_TerrainHeightParams.z, 0.0001);
    float detailFrequency = max(_TerrainHeightParams.w, 0.0001);
    float broad = sin(p.x * frequency) * cos(p.y * frequency * 0.82);
    float longWave = sin((p.x * 0.62 + p.y * 0.78) * frequency * 0.62);
    float detail = sin(p.x * detailFrequency) * sin(p.y * detailFrequency * 0.73);
    return _TerrainHeightParams.x + _TerrainHeightParams.y * (broad * 0.58 + longWave * 0.30 + detail * 0.12);
}

[numthreads(64, 1, 1)]
void CullGrass(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_SourceCount)
    {
        return;
    }

    float4 blade = _SourceBladeData[_SourceOffset + id.x];
    float2 scaledBladeXZ = blade.xy * _FieldScale.xy;
    float2 worldXZ = float2(_FieldOrigin.x + scaledBladeXZ.x, _FieldOrigin.z + scaledBladeXZ.y);
    float3 worldPosition = float3(worldXZ.x, _FieldOrigin.y + SampleTerrainHeight(worldXZ) + _BladeHeight * blade.w * 0.5, worldXZ.y);
    float3 toCamera = worldPosition - _CameraPosition.xyz;
    float distanceToCamera = length(toCamera);

    if (distanceToCamera > _MaxDrawDistance)
    {
        return;
    }

    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float planeDistance = dot(_FrustumPlanes[i].xyz, worldPosition) + _FrustumPlanes[i].w;
        if (planeDistance < -_CullPadding)
        {
            return;
        }
    }

    float density = SampleDensity(blade.xy);
    if (density <= _DensityThreshold)
    {
        return;
    }

    float survival = saturate((density - _DensityThreshold) / max(1.0 - _DensityThreshold, 0.001));
    if (Hash12(blade.xy + 19.37) > survival)
    {
        return;
    }

    if (distanceToCamera < _Lod0Distance)
    {
        _VisibleBladeData0.Append(blade);
    }
    else if (distanceToCamera < _Lod1Distance)
    {
        _VisibleBladeData1.Append(blade);
    }
    else
    {
        _VisibleBladeData2.Append(blade);
    }
}
